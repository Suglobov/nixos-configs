(defcfg
  process-unmapped-keys yes
	;; Чем завершать hex-код: space или enter
	;; linux-unicode-termination enter
)

(defsrc
	esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
	grv  1    2    3    4    5    6    7    8    9    0    -    =   bspc
	tab  q    w    e    r    t    y    u    i    o    p    [    ]   \
	caps a    s    d    f    g    h    j    k    l    ;    '    ret
	lsft z    x    c    v    b    n    m    ,    .    /    rsft
	lctl lmet lalt           spc            ralt rmet cmp  rctl
)

(defvar
	tap-time 150
	hold-time 200
)

(defalias
	;; Левая рука
	a (tap-hold $tap-time $hold-time a lsft)	;; A → Shift
	s (tap-hold $tap-time $hold-time s lctl)	;; S → Ctrl
	d (tap-hold $tap-time $hold-time d lalt)	;; D → Alt
	f (tap-hold $tap-time $hold-time f lmet)	;; F → Super
	;; Правая рука (зеркально)
	j (tap-hold $tap-time $hold-time j rmet)	;; J → Super
	k (tap-hold $tap-time $hold-time k ralt)	;; K → Alt
	l (tap-hold $tap-time $hold-time l rctl)	;; L → Ctrl
	; (tap-hold $tap-time $hold-time ; rsft)	;; ; → Shift
)

(deflayermap (base)
	;; a @a
	;; s @s
	;; d @d
	;; f @f
	;; j @j
	;; k @k
	;; l @l
	;; ; @;

	;; тап — нажатие, держишь — слой nav
	ralt (tap-hold $tap-time $hold-time ralt (layer-while-held nav))
)
(deflayermap (nav)
	h left
	j down
	k up
	l right
	n home
	m pgdn
	, pgup
	. end

	a left
	s down
	d up
	f right
	z home
	c pgup
	x pgdn
	v end

	;; Полезные добавки по желанию:
	;; c C-left   ;; прыжок по словам
	;; v C-right
)
